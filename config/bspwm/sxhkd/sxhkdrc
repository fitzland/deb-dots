##---------- Keybindings for apps ----------##

# Search
super + F1
	catfish

# Editor
super + {_,shift} + F2
	{code,alacritty --config-file ~/.config/alacritty/alacritty.toml -e micro}

# Writer/Calc
super + {_,shift} + F3
    {lowriter,localc}

# Inkscape/Gimp
super + {_,shift} +F4
    {inkscape,gimp}

# Meld
super + F5
    meld

# GnuCash
super + F6
    gnucash

# KeePassXC
super + {_,shift} + F7
    keepassxc {$HOME/Dropbox/journal/home.kdbx,keepassxc $HOME/Dropbox/journal/work.kdbx}

# File Manager
super + {_,shift} + F8
    {thunar,alacritty --config-file ~/.config/alacritty/alacritty.toml -e ranger}

# Markdown Editor
super + {_,shift} + F9
    {ghostwriter,typora}

# Firefox
super + {_,shift} + F10
    {firefox-devedition,firefox-devedition --private-window}

#Microsoft Edge
super + {_,shift} + F11
    {microsoft-edge-stable --profile-directory='Profile 1',microsoft-edge-stable --profile-directory='Default'}

#Chrome Primary
super + {_,shift} + F12
    {google-chrome-stable --profile-directory='Default',google-chrome-stable --profile-directory='Profile 1'}

##---------- Rofi Launcher & Menus ----------##

# Rofi App Launcher
super + {_,shift} + slash
	{sh ~/.config/bspwm/rofi/bin/{launcher-app,asroot}

# Rofi Term Launcher
super + {_,shift} + backslash
	sh ~/.config/bspwm/rofi/bin/{launcher-cmd,windows}

# terminal & filemanager (alacritty & thunar)
super + {_,shift} + Return
	{alacritty,thunar}

# Launch Browser (Firefox)
super + b
	firefox-devedition

# Launch Private Browser (Firefox Incognito Mode)
super + shift + b
	firefox-devedition -private-window

# Launch Rofi Application Menu
super + space
   	rofi -show drun -modi drun -line-padding 4 -hide-scrollbar -show-icons -theme ~/.config/bspwm/rofi/config.rasi

# Show Keybinding Help Script
super + h
  ~/.config/bspwm/scripts/help

# Launch File Manager (Thunar)
super + f
	thunar

# Launch Code (Text Editor)
super + e
	code

# Launch GIMP (Image Editor)
super + g
	gimp

# Launch Pulsemixer (Audio Mixer in Tilix)
super + v
   alacritty -e pulsemixer

# Launch Discord
super + d
	Discord

# Set Window State: Floating Mode
super + shift + space
	bspc node -t ~floating

# Set Window State: Fullscreen Mode
super + shift + f
	bspc node -t fullscreen

# Reload sxhkd (Hotkey Daemon)
super + Escape
	pkill -USR1 -x sxhkd; notify-send 'sxhkd' 'Reloaded config'
	
# Reload bspwm (Window Manager)
super + shift + r
	bspc wm -r; notify-send 'bspwm' 'Restarted'

# Quit bspwm (Exit Window Manager)
super + shift + q
	bspc quit

# Close Focused Window
super + q
	bspc node -c
	
# alternate between the tiled and monocle layout
super + m
	bspc desktop -l next

# set the window state
super + {t,shift + t,s,f}
	bspc node -t {tiled,pseudo_tiled,floating,fullscreen}

# set the node flags
super + ctrl + {m,x,y,z}
	bspc node -g {marked,locked,sticky,private}

# Shutdown or Reboot
super + x
	~/.config/bspwm/rofi/bin/powermenu

# focus the node in the given direction
super + {_,shift + }{Left,Down,Up,Right}
	bspc node -{f,s} {west,south,north,east}

# focus workspace 1-10
super + {1-9,0}
	bspc desktop --focus ^{1-9,10}
super + {KP_1,KP_End}
    bspc desktop --focus ^1
super + {KP_2,KP_Down}
    bspc desktop --focus ^2	
super + {KP_3,KP_Next}
	bspc desktop --focus ^3
super + {KP_4,KP_Left}
	bspc desktop --focus ^4
super + {KP_5,KP_Begin}
	bspc desktop --focus ^5
super + {KP_6,KP_Right}
	bspc desktop --focus ^6
super + {KP_7,KP_Home}
	bspc desktop --focus ^7
super + {KP_8,KP_Up}	
	bspc desktop --focus ^8
super + {KP_9,KP_Prior}
	bspc desktop --focus ^9
super + {KP_0,KP_Insert}
	bspc desktop --focus ^10

# send to workspace 1-10
super + shift + {1-9,0}
	bspc node --to-desktop '^{1-9,10}'
super + shift + {KP_1,KP_End}
    bspc node --to-desktop '^1'
super + shift + {KP_2,KP_Down}
    bspc node --to-desktop '^2'
super + shift + {KP_3,KP_Next}
	bspc node --to-desktop '^3'
super + shift + {KP_4,KP_Left}
	bspc node --to-desktop '^4'
super + shift + {KP_5,KP_Begin}
	bspc node --to-desktop '^5'
super + shift + {KP_6,KP_Right}
	bspc node --to-desktop '^6'
super + shift + {KP_7,KP_Home}
	bspc node --to-desktop '^7'
super + shift + {KP_8,KP_Up}
	bspc node --to-desktop '^8'
super + shift + {KP_9,KP_Prior}
	bspc node --to-desktop '^9'
super + shift + {KP_0,KP_Insert}
	bspc node --to-desktop '^10'

# Move focus to other monitor
super + BackSpace
		bspc monitor -f next

# Move focused window to other monitor
alt + ctrl + Left
	bspc node -m next --follow

# Move focused window to other monitor
alt + ctrl + Right
		bspc node -m next --follow

# Cycle to next/previous OCCUPIED desktop on current monitor
super + period
    bspc desktop -f next.occupied
super + comma
    bspc desktop -f prev.occupied

# Cycle to next/previous ANY desktop on current monitor
super + bracketright
    bspc desktop -f next.local
super + bracketleft
    bspc desktop -f prev.local

	
# Expand window width both sides
super + ctrl + Left
	bspc node -z right 40 0; bspc node -z left 40 0

# Shrink window width both sides 
super + ctrl + Right
	bspc node -z right -40 0; bspc node -z left -40 0

# Resize Window: Shrink Down
super + ctrl + Down
	bspc node -z top 0 40; bspc node -z bottom 40 0

# Resize Window: Shrink Up
super + ctrl + Up
	bspc node -z top 0 -40; bspc node -z bottom -40 0

# Increase Volume (Custom Script)
super + Insert
    ~/.config/bspwm/scripts/changevolume up

# Decrease Volume (Custom Script)
super + Delete
	~/.config/bspwm/scripts/changevolume down

# Mute Volume (Custom Script)
super + m
	~/.config/bspwm/scripts/changevolume mute

# Increase Volume (Using pamixer)
XF86AudioRaiseVolume
	pamixer -i 2

# Decrease Volume (Using pamixer)
XF86AudioLowerVolume
	pamixer -d 2

# Increase Screen Brightness
XF86MonBrightnessUp
	xbacklight +10

# Decrease Screen Brightness
XF86MonBrightnessDown
	xbacklight -10

# Take a Screenshot (Region Select)
super + Print
	flameshot gui --path ~/Screenshots/

# Take a Fullscreen Screenshot
Print
	flameshot full --path ~/Screenshots/
	
# Enable Redshift (Night Light)
super + alt + r
	~/.config/bspwm/scripts/redshift-on

# Disable Redshift (Night Light)
super + alt + b
	~/.config/bspwm/scripts/redshift-off

# Resize All Windows Equally
super + equal
	bspc query -N -d | xargs -I % bspc node % -B
