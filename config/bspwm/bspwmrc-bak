#! /bin/sh

# Set display from arandr saved script
sh ~/.screenlayout/monitor-debian.sh &

bspc monitor DP-2 -d term code ofc grfx misc 
bspc monitor DP-1 -d web chat file mdia util
bspc config focus_on_window_activation	urgent

bspc config border_width			2
bspc config window_gap				5

bspc config split_ratio				0.55
bspc config single_monocle			false
bspc config focus_follows_pointer	true
bspc config borderless_monocle		true
bspc config gapless_monocle			true

bspc config presel_feedback_color "#3B3D41"
bspc config active_border_color		"#42a5f5"
bspc config focused_border_color "#61c766"
bspc config normal_border_color "#27292D"

## LibreOffice apps to office workspace
declare -a ofc=(libreoffice-writer libreoffice-calc libreoffice-impress \
libreoffice-startcenter libreoffice Soffice *:libreofficedev *:soffice)
for i in ${ofc[@]}; do
   bspc rule -a $i desktop='ofc' follow=on focus=on; done

# DP-2 monitor (term code ofc grfx misc)
bspc rule -a Alacritty desktop='term' follow=on
bspc rule -a Code desktop='code' follow=on
bspc rule -a 'GitHub Desktop' desktop='code' follow=on
bspc rule -a Gimp desktop='grfx' follow=on
bspc rule -a Inkscape desktop='grfx' follow=on

# DP-1 monitor (web chat file mdia util)
bspc rule -a Google-chrome desktop='web' follow=on
bspc rule -a discord desktop='chat' follow=on
bspc rule -a Thunar desktop='file' follow=on
bspc rule -a Spotify desktop='mdia' follow=on

bspc rule -a qimgv state=floating
bspc rule -a Xarchiver state=floating
bspc rule -a Galculator state=floating
bspc rule -a mpv state=floating 
bspc rule -a Pavucontrol:pavucontrol state=floating 
bspc rule -a Lxappearance state=floating 

# fix some Java applications
wmname LG3D

# Autostart
#
# Cursor
xsetroot -cursor_name left_ptr &
# Polkit
/usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1 &
# Notifications
dunst -config ~/.config/bspwm/dunst/dunstrc &
picom --config ~/.config/bspwm/picom/picom.conf --animations -b &
feh --bg-fill ~/.config/bspwm/wallpaper/wallhaven-vq76dp_3440x1440.png &
#~/.fehbg

## Polybar or tint
~/.config/bspwm/polybar/polybar-bspwm &

## apps for systray if enabled
# volumeicon &
pgrep nm-applet > /dev/null || nm-applet &
blueman-applet &
pgrep dropbox || sh ~/.dropbox-dist/dropboxd &


# (re)load sxhkd for keybinds
if hash sxhkd >/dev/null 2>&1; then
	pkill sxhkd
	sleep 0.5
	sxhkd -c "$HOME/.config/bspwm/sxhkd/sxhkdrc" &
fi
